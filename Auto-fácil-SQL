-- CONSULTA COM RELACIONAMENTO ENTRE TABELAS
SELECT
    clientes.nome AS cliente,
    vendedores.nome AS vendedor,
    veiculos.modelo AS veiculo,
    vendas.data_venda,
    vendas.valor
FROM vendas
INNER JOIN clientes
    ON vendas.id_cliente = clientes.id_cliente
INNER JOIN vendedores
    ON vendas.id_vendedor = vendedores.id_vendedor
INNER JOIN veiculos
    ON vendas.id_veiculo = veiculos.id_veiculo;
